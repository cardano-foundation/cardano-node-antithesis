cabal-version: 3.0
name:          asteria-game
version:       0.1.0.0
synopsis:      Asteria game bootstrap+player for the antithesis cluster
description:
  A container with a long-running UTxO indexer and three short-lived
  game executables: @asteria-bootstrap@, @asteria-game@ and
  @asteria-invariant@. The cardano-tx-tools TxBuild DSL,
  parameter-applied Aiken validators and Antithesis-controlled
  randomness drive and check real Plutus transactions.

license:       Apache-2.0
license-file:  LICENSE
author:        HAL team
maintainer:    hal@cardano-foundation.org
category:      Testing
build-type:    Simple

common settings
  ghc-options:
    -Wall -Wunused-imports -Wunused-packages -Wname-shadowing
    -Wredundant-constraints

  default-extensions:
    DataKinds
    DerivingStrategies
    GADTs
    ImportQualifiedPost
    LambdaCase
    NumericUnderscores
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    StrictData
    TypeApplications

library
  import:           settings
  hs-source-dirs:   src
  default-language: GHC2021
  build-depends:
    , aeson
    , async
    , base
    , base16-bytestring
    , bytestring
    , cardano-crypto-class
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-node-clients
    , cardano-slotting
    , cardano-tx-tools:tx-build
    , containers
    , directory
    , file-embed
    , filepath
    , microlens
    , mtl
    , ouroboros-network
    , plutus-core
    , plutus-ledger-api
    , plutus-tx
    , random
    , text

  exposed-modules:
    Asteria.Crypto
    Asteria.Datums
    Asteria.Deploy
    Asteria.Game
    Asteria.Provider
    Asteria.RandomSource
    Asteria.Sdk
    Asteria.Validators
    Asteria.Wallet

executable asteria-bootstrap
  import:           settings
  main-is:          BootstrapMain.hs
  hs-source-dirs:   app
  default-language: GHC2021
  ghc-options:      -threaded
  build-depends:
    , aeson
    , asteria-game
    , base
    , bytestring
    , cardano-crypto-class
    , cardano-ledger-api
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-node-clients
    , cardano-tx-tools:tx-build
    , containers
    , microlens
    , text

executable asteria-game
  import:           settings
  main-is:          PlayerMain.hs
  hs-source-dirs:   app
  default-language: GHC2021
  ghc-options:      -threaded
  build-depends:
    , aeson
    , asteria-game
    , base
    , bytestring
    , cardano-crypto-class
    , cardano-ledger-alonzo
    , cardano-ledger-api
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-node-clients
    , cardano-slotting
    , cardano-tx-tools:tx-build
    , containers
    , hashable
    , microlens
    , plutus-tx
    , text
    , time

executable asteria-invariant
  import:           settings
  main-is:          InvariantMain.hs
  hs-source-dirs:   app
  default-language: GHC2021
  ghc-options:      -threaded
  build-depends:
    , aeson
    , asteria-game
    , base
    , bytestring
    , cardano-ledger-api
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-node-clients
    , containers
    , microlens
    , plutus-ledger-api
    , plutus-tx
    , text
