-- Pin Cardano and Ouroboros packages for the cardano-node 11.2.0 line.
-- Versions come from the resolved node 11.2.0 build plan.
constraints:
    cardano-binary == 1.9.1.0
  , cardano-crypto-class == 2.6.0.0
  , cardano-crypto-praos == 2.2.4.0
  , cardano-crypto-wrapper == 1.8.0.0
  , cardano-data == 1.4.0.0
  , cardano-diffusion == 1.3.0.1
  , cardano-ledger-allegra == 1.10.2.0
  , cardano-ledger-alonzo == 1.17.0.0
  , cardano-ledger-api == 1.15.0.0
  , cardano-ledger-babbage == 1.15.0.0
  , cardano-ledger-binary == 1.10.1.0
  , cardano-ledger-byron == 1.3.0.0
  , cardano-ledger-conway == 1.24.0.0
  , cardano-ledger-core == 1.22.0.0
  , cardano-ledger-dijkstra == 0.4.0.0
  , cardano-ledger-mary == 1.11.1.0
  , cardano-ledger-shelley == 1.20.0.0
  , cardano-prelude == 0.2.2.0
  , cardano-protocol-tpraos == 1.6.0.1
  , cardano-slotting == 0.2.2.0
  , cuddle == 1.8.1.0
  , quickcheck-state-machine == 0.10.4
  , ouroboros-consensus == 5.2.0.0
  , ouroboros-network == 2.0.0.0
  , plutus-core == 1.71.0.0
  , typed-protocols == 1.2.2.0
  , kes-agent == 1.4.0.0
  , network-mux == 1.0.0.0

package ouroboros-consensus
  tests: False
  benchmarks: False

package ouroboros-network
  tests: False
